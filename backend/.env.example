# ==============================================================================
# SOC Analyst Co-Pilot — Example Environment Configuration
# ==============================================================================

# OpenRouter API Key — export your real API key here
OPENROUTER_API_KEY=

# OpenRouter Model Routing
OPENROUTER_PRIMARY_MODEL=deepseek/deepseek-v4-pro
OPENROUTER_FALLBACK_MODEL=qwen/qwen-2.5-72b-instruct
OPENROUTER_MODEL=deepseek/deepseek-v4-pro

# OpenRouter Base URL endpoint
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Request timeout in seconds
OPENROUTER_TIMEOUT=180

# Application Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
